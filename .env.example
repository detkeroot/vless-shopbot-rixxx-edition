# =================================================================
# VLESS Shop Bot (RIXXX Edition) - Environment Variables Template
# =================================================================
# Все основные настройки бота (токены Telegram, шлюзы ЮKassa, CryptoBot,
# данные хостов и тарифов) настраиваются через Веб-Панель (порт 1488).
#
# Данный файл используется для опционального переопределения системных параметров.
# =================================================================

# Секретный ключ для сессий Flask веб-панели (рекомендуется сгенерировать случайную строку)
FLASK_SECRET_KEY=generate_random_secret_key_here

# Порт веб-панели (по умолчанию 1488)
WEBHOOK_PORT=1488

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
